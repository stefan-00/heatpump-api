    {
        "id": "9437ab5b75382a6d",
        "type": "function",
        "z": "tab_pool_visual",
        "name": "Min on-time gate",
        "func": "// Minimum on-time, so the heat pump is not short-cycled.\n//\n// Acts only on real transitions. The previous version re-sent \"on\" every time it\n// received one, which turned each upstream sensor twitch into another\n// number.set_value call - 15 identical enable calls in 5 minutes, and zero\n// disables, because \"off\" was always swallowed by the min-on-time while \"on\"\n// passed straight through.\nconst MIN_ON_MS = 30 * 60 * 1000;   // 30 minutes\n\nconst want = msg.payload;            // \"on\" | \"off\"\nconst sent = context.get(\"sent\");    // last state actually forwarded\n\nif (want === \"on\") {\n    // Cancel any scheduled off - we want to stay on.\n    const pending = context.get(\"offTimer\");\n    if (pending) { clearTimeout(pending); context.set(\"offTimer\", null); }\n\n    if (sent === \"on\") { return null; }   // already on, nothing to command\n    context.set(\"sent\", \"on\");\n    context.set(\"onSince\", Date.now());\n    node.status({ fill: \"green\", shape: \"dot\", text: \"on\" });\n    node.send({ payload: \"on\" });\n    return null;\n}\n\n// want === \"off\"\nif (sent !== \"on\") { return null; }              // already off\nif (context.get(\"offTimer\")) { return null; }    // an off is already scheduled\n\nconst remaining = MIN_ON_MS - (Date.now() - (context.get(\"onSince\") || 0));\nif (remaining <= 0) {\n    context.set(\"sent\", \"off\");\n    node.status({ fill: \"grey\", shape: \"dot\", text: \"off\" });\n    node.send({ payload: \"off\" });\n} else {\n    node.status({\n        fill: \"yellow\", shape: \"ring\",\n        text: `off in ${Math.round(remaining / 60000)} min`\n    });\n    context.set(\"offTimer\", setTimeout(() => {\n        context.set(\"offTimer\", null);\n        context.set(\"sent\", \"off\");\n        node.status({ fill: \"grey\", shape: \"dot\", text: \"off\" });\n        node.send({ payload: \"off\" });\n    }, remaining));\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "const pending = context.get(\"offTimer\");\nif (pending) { clearTimeout(pending); context.set(\"offTimer\", null); }",
        "libs": [],
        "x": 290,
        "y": 360,
        "wires": [
            [
                "85914a7da1c0c0cc"
            ]
        ]
