    {
        "id": "logic",
        "type": "function",
        "z": "tab_pool_visual",
        "name": "Should Heat?",
        "func": "let battery_soc = flow.get('battery_soc') || 0;\nlet grid_exporting = flow.get('grid_exporting');\nlet sell_price = flow.get('sell_price') || 0;\nlet solar_power = flow.get('solar_power') || 0;\nlet pool_temp = flow.get('pool_temp') || 0;\n\nlet shouldHeat = (\n    pool_temp < 26\n    && solar_power > 3.0\n    && (battery_soc > 0.1\n    || (grid_exporting && sell_price < 1.0))\n);\n\nmsg.payload = shouldHeat ? \"on\" : \"off\";\n\nmsg.attributes = {\n    pool_temp: pool_temp,\n    battery_soc: battery_soc,\n    grid_exporting: grid_exporting,\n    sell_price: sell_price,\n    solar_power: solar_power,\n    shouldHeat: shouldHeat\n};\nnode.warn(msg.attributes);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 280,
        "wires": [
            [
                "b4809cf3af2f0a72"
            ]
        ]
    },
