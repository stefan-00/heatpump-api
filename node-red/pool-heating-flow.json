    {
        "id": "9437ab5b75382a6d",
        "type": "function",
        "z": "tab_pool_visual",
        "name": "Delay",
        "func": "const MIN_ON = 30 * 60 * 1000;  // hold ON for at least 10 min\n\n  if (msg.payload === \"on\") {\n      context.set(\"onSince\", Date.now());\n      const pending = context.get(\"offTimer\");\n      if (pending) { clearTimeout(pending); context.set(\"offTimer\", null); }\n      node.send({ payload: \"on\" });\n      return null;\n  }\n  \n  // payload === \"off\"\n  const remaining = MIN_ON - (Date.now() - (context.get(\"onSince\") || 0));\n  if (remaining <= 0) {\n      node.send({ payload: \"off\" });\n  } else {\n      const t = setTimeout(() => {\n          node.send({ payload: \"off\" });\n          context.set(\"offTimer\", null);\n      }, remaining);\n      context.set(\"offTimer\", t);\n  }\n  return null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 290,
        "y": 360,
        "wires": [
            [
                "85914a7da1c0c0cc"
            ]
        ]
