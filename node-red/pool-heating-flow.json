    {
        "id": "logic",
        "type": "function",
        "z": "tab_pool_visual",
        "name": "Should Heat?",
        "func": "// Decide whether the pool should be heated.\n//\n// Every threshold here is hysteretic. Bare thresholds chatter: pv_power crosses\n// 3 kW constantly on a broken-cloud day and pool_temp sits within sensor noise\n// of its limit, so a single comparison flips the decision every few seconds.\n// Each input therefore has a different threshold depending on whether we are\n// already heating.\nconst POOL_ON_BELOW    = 26.0;   // start heating below this\nconst POOL_OFF_ABOVE   = 27.5;   // ...and stop only once above this\nconst SOLAR_ON_ABOVE   = 3.0;    // kW of PV production to start\nconst SOLAR_OFF_BELOW  = 2.5;    // ...and to keep going\nconst BATTERY_ON_ABOVE = 10;     // percent SOC - NOT 0.1, this is 0-100\nconst BATTERY_OFF_BELOW = 8;\nconst MAX_SELL_PRICE   = 1.0;\n\n// A missing pool temperature must not read as \"cold\": defaulting to 0 made\n// `pool_temp < 26` true and enabled heating on no data at all. Solar and SOC\n// default low, which fails safe on its own.\nlet pool_temp = flow.get('pool_temp');\nif (typeof pool_temp !== 'number' || isNaN(pool_temp)) { pool_temp = 99; }\n\nconst battery_soc = flow.get('battery_soc') || 0;\nconst grid_exporting = flow.get('grid_exporting') || false;\nconst sell_price = flow.get('sell_price') || 0;\nconst solar_power = flow.get('solar_power') || 0;\n\nconst wasHeating = flow.get('heating') === true;\n\nconst poolWantsHeat = wasHeating\n    ? pool_temp < POOL_OFF_ABOVE\n    : pool_temp < POOL_ON_BELOW;\n\nconst solarOk = wasHeating\n    ? solar_power > SOLAR_OFF_BELOW\n    : solar_power > SOLAR_ON_ABOVE;\n\n// Either the battery is comfortable enough to lend us the power, or we are\n// exporting anyway and the sell price is low enough that heating beats selling.\nconst batteryOk = wasHeating\n    ? battery_soc > BATTERY_OFF_BELOW\n    : battery_soc > BATTERY_ON_ABOVE;\nconst energyOk = batteryOk || (grid_exporting && sell_price < MAX_SELL_PRICE);\n\nconst shouldHeat = poolWantsHeat && solarOk && energyOk;\nflow.set('heating', shouldHeat);\n\nmsg.payload = shouldHeat ? \"on\" : \"off\";\nmsg.attributes = {\n    pool_temp: pool_temp,\n    battery_soc: battery_soc,\n    grid_exporting: grid_exporting,\n    sell_price: sell_price,\n    solar_power: solar_power,\n    poolWantsHeat: poolWantsHeat,\n    solarOk: solarOk,\n    energyOk: energyOk,\n    shouldHeat: shouldHeat\n};\n\n// node.status instead of node.warn: this runs on every sensor update, and\n// node.warn floods the Node-RED log. The status shows under the node instead.\nnode.status({\n    fill: shouldHeat ? \"green\" : \"grey\",\n    shape: \"dot\",\n    text: `${msg.payload} pool=${pool_temp} pv=${solar_power} soc=${battery_soc}`\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 280,
        "wires": [
            [
                "b4809cf3af2f0a72"
            ]
        ]
